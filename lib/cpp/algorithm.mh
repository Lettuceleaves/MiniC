#ifndef MINIC_CPP_ALGORITHM_MH
#define MINIC_CPP_ALGORITHM_MH
#include "iterator.mh"
#include "functional.mh"
#include "initializer_list.mh"
#include <stdlib.h>
namespace std {
template<class T,class C> constexpr const T& min(const T& a,const T& b,C comp) { return comp(b,a)?b:a; }
template<class T> constexpr const T& min(const T& a,const T& b) { return b<a?b:a; }
template<class T,class C> constexpr const T& max(const T& a,const T& b,C comp) { return comp(a,b)?b:a; }
template<class T> constexpr const T& max(const T& a,const T& b) { return a<b?b:a; }
template<class I,class O> O copy(I first,I last,O out) { while(first!=last){*out=*first;++first;++out;}return out; }
template<class I,class N,class O> O copy_n(I first,N n,O out) { while(n>0){*out=*first;++first;++out;--n;}return out; }
template<class I,class O> O copy_backward(I first,I last,O out) { while(first!=last){--last;--out;*out=*last;}return out; }
template<class I,class O> O move(I first,I last,O out) { while(first!=last){*out=std::move(*first);++first;++out;}return out; }
template<class I,class O> O move_backward(I first,I last,O out) { while(first!=last){--last;--out;*out=std::move(*last);}return out; }
template<class I,class T> void fill(I first,I last,const T& value) { while(first!=last){*first=value;++first;} }
template<class I,class N,class T> I fill_n(I first,N count,const T& value) { while(count>0){*first=value;++first;--count;}return first; }
template<class I,class J,class P> bool equal(I first,I last,J other,P pred) { while(first!=last){if(!pred(*first,*other))return false;++first;++other;}return true; }
template<class I,class J> bool equal(I first,I last,J other) { return std::equal(first,last,other,equal_to<void>()); }
template<class I,class J,class P> bool equal(I first,I last,J other,J end,P pred) {
    while(first!=last && other!=end){if(!pred(*first,*other))return false;++first;++other;}
    return first==last && other==end;
}
template<class I,class J> bool equal(I first,I last,J other,J end) { return std::equal(first,last,other,end,equal_to<void>()); }
template<class I,class T> I find(I first,I last,const T& value) { while(first!=last && !(*first==value))++first;return first; }
template<class I,class P> I find_if(I first,I last,P pred) { while(first!=last && !pred(*first))++first;return first; }
template<class I,class T> typename iterator_traits<I>::difference_type count(I first,I last,const T& value) { typename iterator_traits<I>::difference_type n=0;while(first!=last){if(*first==value)++n;++first;}return n; }
template<class I,class P> typename iterator_traits<I>::difference_type count_if(I first,I last,P pred) { typename iterator_traits<I>::difference_type n=0;while(first!=last){if(pred(*first))++n;++first;}return n; }
template<class I,class J> void iter_swap(I a,J b) { using std::swap;swap(*a,*b); }
template<class I,class J> J swap_ranges(I first,I last,J other) { while(first!=last){std::iter_swap(first,other);++first;++other;}return other; }
template<class I> void reverse(I first,I last) { while(first!=last){--last;if(first==last)break;std::iter_swap(first,last);++first;} }
template<class I,class P> I unique(I first,I last,P pred) {
    if(first==last)return last;
    I out=first;
    while(++first!=last)if(!pred(*out,*first)){++out;if(out!=first)*out=std::move(*first);}
    return ++out;
}
template<class I> I unique(I first,I last) { return std::unique(first,last,equal_to<typename iterator_traits<I>::value_type>()); }
template<class I,class T> I remove(I first,I last,const T& value) { I out=std::find(first,last,value);if(out==last)return out;I it=out;while(++it!=last)if(!(*it==value)){*out=std::move(*it);++out;}return out; }
template<class I,class P> I remove_if(I first,I last,P pred) { I out=std::find_if(first,last,pred);if(out==last)return out;I it=out;while(++it!=last)if(!pred(*it)){*out=std::move(*it);++out;}return out; }
template<class I,class T,class C> I lower_bound(I first,I last,const T& value,C comp) {
    typename iterator_traits<I>::difference_type n=std::distance(first,last);
    while(n>0){typename iterator_traits<I>::difference_type half=n/2;I middle=first;std::advance(middle,half);if(comp(*middle,value)){first=++middle;n-=half+1;}else n=half;}
    return first;
}
template<class I,class T> I lower_bound(I first,I last,const T& value) { return std::lower_bound(first,last,value,less<void>()); }
template<class I,class T,class C> I upper_bound(I first,I last,const T& value,C comp) {
    typename iterator_traits<I>::difference_type n=std::distance(first,last);
    while(n>0){typename iterator_traits<I>::difference_type half=n/2;I middle=first;std::advance(middle,half);if(!comp(value,*middle)){first=++middle;n-=half+1;}else n=half;}
    return first;
}
template<class I,class T> I upper_bound(I first,I last,const T& value) { return std::upper_bound(first,last,value,less<void>()); }
template<class I,class T,class C> bool binary_search(I first,I last,const T& value,C comp) { I it=std::lower_bound(first,last,value,comp);return it!=last && !comp(value,*it); }
template<class I,class T> bool binary_search(I first,I last,const T& value) { return std::binary_search(first,last,value,less<void>()); }
template<class I,class T,class C> pair<I,I> equal_range(I first,I last,const T& value,C comp) { I lower=std::lower_bound(first,last,value,comp);return pair<I,I>(lower,std::upper_bound(lower,last,value,comp)); }
template<class I,class T> pair<I,I> equal_range(I first,I last,const T& value) { return std::equal_range(first,last,value,less<void>()); }
template<class I,class C> bool next_permutation(I first,I last,C comp) {
    if(first==last)return false;I next=last;--next;if(first==next)return false;
    while(true){I at=next;--next;if(comp(*next,*at)){I target=last;while(!comp(*next,*--target)){}std::iter_swap(next,target);std::reverse(at,last);return true;}if(next==first){std::reverse(first,last);return false;}}
}
template<class I> bool next_permutation(I first,I last) { return std::next_permutation(first,last,less<void>()); }
template<class I,class C> bool prev_permutation(I first,I last,C comp) {
    if(first==last)return false;I next=last;--next;if(first==next)return false;
    while(true){I at=next;--next;if(comp(*at,*next)){I target=last;while(!comp(*--target,*next)){}std::iter_swap(next,target);std::reverse(at,last);return true;}if(next==first){std::reverse(first,last);return false;}}
}
template<class I> bool prev_permutation(I first,I last) { return std::prev_permutation(first,last,less<void>()); }
template<class I,class D,class C> void __minic_sift_down(I first,D root,D n,C& comp) {
    typename iterator_traits<I>::value_type value=std::move(*(first+root));
    while(root<n/2){D child=root*2+1;if(child+1<n && comp(*(first+child),*(first+child+1)))++child;if(!comp(value,*(first+child)))break;*(first+root)=std::move(*(first+child));root=child;}
    *(first+root)=std::move(value);
}
template<class I,class C> void push_heap(I first,I last,C comp) {
    typename iterator_traits<I>::difference_type n=std::distance(first,last);if(n<2)return;
    typename iterator_traits<I>::difference_type at=n-1;
    typename iterator_traits<I>::value_type value=std::move(*(first+at));
    while(at>0){typename iterator_traits<I>::difference_type parent=(at-1)/2;if(!comp(*(first+parent),value))break;*(first+at)=std::move(*(first+parent));at=parent;}
    *(first+at)=std::move(value);
}
template<class I> void push_heap(I first,I last) { std::push_heap(first,last,less<void>()); }
template<class I,class C> void pop_heap(I first,I last,C comp) { typename iterator_traits<I>::difference_type n=std::distance(first,last);if(n<2)return;std::iter_swap(first,last-1);std::__minic_sift_down(first,(typename iterator_traits<I>::difference_type)0,n-1,comp); }
template<class I> void pop_heap(I first,I last) { std::pop_heap(first,last,less<void>()); }
template<class I,class C> void make_heap(I first,I last,C comp) { typename iterator_traits<I>::difference_type n=std::distance(first,last);typename iterator_traits<I>::difference_type at=n/2;while(at>0){--at;std::__minic_sift_down(first,at,n,comp);} }
template<class I> void make_heap(I first,I last) { std::make_heap(first,last,less<void>()); }
template<class I,class C> void sort_heap(I first,I last,C comp) { while(std::distance(first,last)>1){std::pop_heap(first,last,comp);--last;} }
template<class I> void sort_heap(I first,I last) { std::sort_heap(first,last,less<void>()); }
template<class I,class C> void __minic_insertion_sort(I first,I last,C& comp) {
    if(first==last)return;
    for(I at=first+1;at!=last;++at){typename iterator_traits<I>::value_type value=std::move(*at);I hole=at;while(hole!=first && comp(value,*(hole-1))){*hole=std::move(*(hole-1));--hole;}*hole=std::move(value);}
}
template<class I,class C> void __minic_introsort(I first,I last,int depth,C& comp) {
    while(last-first>16){
        if(depth==0){std::make_heap(first,last,comp);std::sort_heap(first,last,comp);return;}--depth;
        I middle=first+(last-first)/2;I pivot=last-1;
        if(comp(*middle,*first))std::iter_swap(middle,first);
        if(comp(*pivot,*first))std::iter_swap(pivot,first);
        if(comp(*pivot,*middle))std::iter_swap(pivot,middle);
        std::iter_swap(middle,pivot);
        I split=first;for(I it=first;it!=pivot;++it)if(comp(*it,*pivot)){if(it!=split)std::iter_swap(it,split);++split;}
        std::iter_swap(split,pivot);
        if(split-first<last-split-1){std::__minic_introsort(first,split,depth,comp);first=split+1;}
        else{std::__minic_introsort(split+1,last,depth,comp);last=split;}
    }
    std::__minic_insertion_sort(first,last,comp);
}
template<class I,class C> void sort(I first,I last,C comp) {
    if(first==last)return;
    typename iterator_traits<I>::difference_type n=last-first;int depth=0;
    while(n>1){n/=2;++depth;}std::__minic_introsort(first,last,2*depth,comp);
}
template<class I> void sort(I first,I last) { std::sort(first,last,less<void>()); }
template<class I,class J,class C> bool lexicographical_compare(I first,I last,J other,J end,C comp) {
    while(first!=last && other!=end){if(comp(*first,*other))return true;if(comp(*other,*first))return false;++first;++other;}
    return first==last && other!=end;
}
template<class I,class J> bool lexicographical_compare(I first,I last,J other,J end) { return std::lexicographical_compare(first,last,other,end,less<void>()); }
template<class T,class C> constexpr T min(initializer_list<T> values,C comp){const T* best=values.begin();for(const T* p=best+1;p!=values.end();++p)if(comp(*p,*best))best=p;return *best;}
template<class T> constexpr T min(initializer_list<T> values){return std::min(values,less<void>());}
template<class T,class C> constexpr T max(initializer_list<T> values,C comp){const T* best=values.begin();for(const T* p=best+1;p!=values.end();++p)if(comp(*best,*p))best=p;return *best;}
template<class T> constexpr T max(initializer_list<T> values){return std::max(values,less<void>());}
template<class G> unsigned long long __minic_uniform_index(G& generator,unsigned long long bound){
    if(bound<=1)return 0;
    unsigned long long low=generator.min(),range=generator.max()-low;
    if(range==0)::abort();
    if(range>=bound-1){
        if(range==bound-1)return (unsigned long long)generator()-low;
        unsigned long long limit=(range/bound)*bound,value;
        do{value=(unsigned long long)generator()-low;}while(value>=limit);
        return value%bound;
    }
    unsigned long long base=range+1,value;
    do{
        unsigned long long high=std::__minic_uniform_index(generator,(bound-1)/base+1);
        unsigned long long tail=(unsigned long long)generator()-low;
        value=high*base+tail;
        if(value<high*base)continue;
        if(value<bound)return value;
    }while(true);
}
template<class I,class G> void shuffle(I first,I last,G&& generator){
    if(first==last)return;
    typename iterator_traits<I>::difference_type n=last-first;
    for(typename iterator_traits<I>::difference_type i=n-1;i>0;--i)std::iter_swap(first+i,first+std::__minic_uniform_index(generator,(unsigned long long)i+1));
}
struct __minic_rand_generator {
    static unsigned int min(){return 0;} static unsigned int max(){return RAND_MAX;}
    unsigned int operator()(){return (unsigned int)::rand();}
};
// Kept as an explicitly documented pre-C++17 compatibility extension.
template<class I> void random_shuffle(I first,I last){__minic_rand_generator generator;std::shuffle(first,last,generator);}
template<class I,class R> void random_shuffle(I first,I last,R&& random){
    if(first==last)return;
    typename iterator_traits<I>::difference_type n=last-first;
    for(typename iterator_traits<I>::difference_type i=1;i<n;++i)std::iter_swap(first+i,first+random(i+1));
}
}
#endif
