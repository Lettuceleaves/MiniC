#ifndef MINIC_CPP_CSTDLIB_MH
#define MINIC_CPP_CSTDLIB_MH
#include <stdlib.h>
namespace std {
using ::malloc;
using ::calloc;
using ::realloc;
using ::free;
using ::atof;
using ::atoi;
using ::atol;
using ::atoll;
using ::strtod;
using ::strtof;
using ::strtol;
using ::strtoll;
using ::strtoul;
using ::strtoull;
using ::abs;
using ::labs;
using ::llabs;
using ::rand;
using ::srand;
using ::abort;
using ::exit;
#if defined(__MINIC__) || defined(__MINIC_SELF_STL__)
long abs(long value){return ::labs(value);}
long long abs(long long value){return ::llabs(value);}
#endif
}
#endif
