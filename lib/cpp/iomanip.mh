#ifndef MINIC_CPP_IOMANIP_MH
#define MINIC_CPP_IOMANIP_MH
#include "iostream.mh"
namespace std {
struct __minic_precision { int value; explicit __minic_precision(int n):value(n) {} };
struct __minic_width { int value; explicit __minic_width(int n):value(n) {} };
struct __minic_fill { char value; explicit __minic_fill(char c):value(c) {} };
struct __minic_base { int value; explicit __minic_base(int n):value(n) {} };
__minic_precision setprecision(int n){return __minic_precision(n);}
__minic_width setw(int n){return __minic_width(n);}
__minic_fill setfill(char c){return __minic_fill(c);}
__minic_base setbase(int n){return __minic_base(n);}
ostream& operator<<(ostream& stream,__minic_precision value){stream.precision(value.value);return stream;}
ostream& operator<<(ostream& stream,__minic_width value){stream.width(value.value);return stream;}
istream& operator>>(istream& stream,__minic_width value){stream.width(value.value);return stream;}
ostream& operator<<(ostream& stream,__minic_fill value){stream.fill(value.value);return stream;}
ostream& operator<<(ostream& stream,__minic_base value){stream.setf(value.value==16?ios::hex:value.value==8?ios::oct:value.value==10?ios::dec:0,ios::basefield);return stream;}
istream& operator>>(istream& stream,__minic_base value){stream.setf(value.value==16?ios::hex:value.value==8?ios::oct:value.value==10?ios::dec:0,ios::basefield);return stream;}
}
#endif
