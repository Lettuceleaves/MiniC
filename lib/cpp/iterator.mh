#ifndef MINIC_CPP_ITERATOR_MH
#define MINIC_CPP_ITERATOR_MH
#include "utility.mh"
#include "initializer_list.mh"
namespace std {
typedef long long ptrdiff_t;
typedef unsigned long long size_t;
struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : public input_iterator_tag {};
struct bidirectional_iterator_tag : public forward_iterator_tag {};
struct random_access_iterator_tag : public bidirectional_iterator_tag {};
template<class... T> struct __minic_iterator_void { typedef void type; };
template<class I,class Enable=void> struct iterator_traits {};
template<class I> struct iterator_traits<I,typename __minic_iterator_void<
    typename I::difference_type,typename I::value_type,typename I::pointer,
    typename I::reference,typename I::iterator_category>::type> {
    typedef typename I::difference_type difference_type;
    typedef typename I::value_type value_type;
    typedef typename I::pointer pointer;
    typedef typename I::reference reference;
    typedef typename I::iterator_category iterator_category;
};
template<class T> struct iterator_traits<T*> {
    typedef ptrdiff_t difference_type;
    typedef T value_type;
    typedef T* pointer;
    typedef T& reference;
    typedef random_access_iterator_tag iterator_category;
};
template<class T> struct iterator_traits<const T*> {
    typedef ptrdiff_t difference_type;
    typedef T value_type;
    typedef const T* pointer;
    typedef const T& reference;
    typedef random_access_iterator_tag iterator_category;
};
template<class I> constexpr typename iterator_traits<I>::difference_type __minic_distance(I first,I last,input_iterator_tag) {
    typename iterator_traits<I>::difference_type n=0;
    while(first!=last){++first;++n;} return n;
}
template<class I> constexpr typename iterator_traits<I>::difference_type __minic_distance(I first,I last,forward_iterator_tag) { return __minic_distance(first,last,input_iterator_tag()); }
template<class I> constexpr typename iterator_traits<I>::difference_type __minic_distance(I first,I last,bidirectional_iterator_tag) { return __minic_distance(first,last,input_iterator_tag()); }
template<class I> constexpr typename iterator_traits<I>::difference_type __minic_distance(I first,I last,random_access_iterator_tag) { return first==last ? 0 : last-first; }
template<class I> constexpr typename iterator_traits<I>::difference_type distance(I first,I last) { return __minic_distance(first,last,typename iterator_traits<I>::iterator_category()); }
template<class I,class D> constexpr void __minic_advance(I& it,D n,input_iterator_tag) { while(n>0){++it;--n;} }
template<class I,class D> constexpr void __minic_advance(I& it,D n,forward_iterator_tag) { __minic_advance(it,n,input_iterator_tag()); }
template<class I,class D> constexpr void __minic_advance(I& it,D n,bidirectional_iterator_tag) { if(n>=0){while(n>0){++it;--n;}}else{while(n<0){--it;++n;}} }
template<class I,class D> constexpr void __minic_advance(I& it,D n,random_access_iterator_tag) { if(n!=0) it+=n; }
template<class I,class D> constexpr void advance(I& it,D n) { __minic_advance(it,n,typename iterator_traits<I>::iterator_category()); }
template<class I> constexpr I next(I it,typename iterator_traits<I>::difference_type n) { std::advance(it,n);return it; }
template<class I> constexpr I next(I it) { ++it;return it; }
template<class I> constexpr I prev(I it,typename iterator_traits<I>::difference_type n) { std::advance(it,-n);return it; }
template<class I> constexpr I prev(I it) { --it;return it; }
template<class I> class reverse_iterator {
protected:
    I current;
public:
    typedef I iterator_type;
    typedef typename iterator_traits<I>::iterator_category iterator_category;
    typedef typename iterator_traits<I>::value_type value_type;
    typedef typename iterator_traits<I>::difference_type difference_type;
    typedef typename iterator_traits<I>::pointer pointer;
    typedef typename iterator_traits<I>::reference reference;
    constexpr reverse_iterator():current() {}
    explicit constexpr reverse_iterator(I it):current(it) {}
    template<class J,typename enable_if<is_convertible<const J&,I>::value,int>::type Enabled=0>
    constexpr reverse_iterator(const reverse_iterator<J>& other):current(other.base()) {}
    template<class J> constexpr typename enable_if<is_assignable<I&,J>::value,reverse_iterator&>::type
    operator=(const reverse_iterator<J>& other) { current=other.base();return *this; }
    constexpr I base() const { return current; }
    constexpr reference operator*() const { I it=current;--it;return *it; }
    constexpr pointer operator->() const { return std::addressof(**this); }
    constexpr reverse_iterator& operator++() { --current;return *this; }
    constexpr reverse_iterator operator++(int) { reverse_iterator saved=*this;--current;return saved; }
    constexpr reverse_iterator& operator--() { ++current;return *this; }
    constexpr reverse_iterator operator--(int) { reverse_iterator saved=*this;++current;return saved; }
    constexpr reverse_iterator operator+(difference_type n) const { return reverse_iterator(current-n); }
    constexpr reverse_iterator operator-(difference_type n) const { return reverse_iterator(current+n); }
    constexpr reverse_iterator& operator+=(difference_type n) { current-=n;return *this; }
    constexpr reverse_iterator& operator-=(difference_type n) { current+=n;return *this; }
    constexpr reference operator[](difference_type n) const { return *(*this+n); }
};
template<class I,class J> constexpr bool operator==(const reverse_iterator<I>& a,const reverse_iterator<J>& b) { return a.base()==b.base(); }
template<class I,class J> constexpr bool operator!=(const reverse_iterator<I>& a,const reverse_iterator<J>& b) { return !(a==b); }
template<class I,class J> constexpr bool operator<(const reverse_iterator<I>& a,const reverse_iterator<J>& b) { return b.base()<a.base(); }
template<class I,class J> constexpr bool operator>(const reverse_iterator<I>& a,const reverse_iterator<J>& b) { return b<a; }
template<class I,class J> constexpr bool operator<=(const reverse_iterator<I>& a,const reverse_iterator<J>& b) { return !(b<a); }
template<class I,class J> constexpr bool operator>=(const reverse_iterator<I>& a,const reverse_iterator<J>& b) { return !(a<b); }
template<class I,class J> constexpr auto operator-(const reverse_iterator<I>& a,const reverse_iterator<J>& b) -> decltype(b.base()-a.base()) { return b.base()-a.base(); }
template<class I> constexpr reverse_iterator<I> operator+(typename reverse_iterator<I>::difference_type n,const reverse_iterator<I>& it) { return it+n; }
template<class I> constexpr reverse_iterator<I> make_reverse_iterator(I iterator) { return reverse_iterator<I>(iterator); }
template<class C> class back_insert_iterator {
protected:
    C* container;
public:
    typedef C container_type;
    typedef output_iterator_tag iterator_category;
    typedef void value_type;
    typedef void difference_type;
    typedef void pointer;
    typedef void reference;
    explicit back_insert_iterator(C& target):container(std::addressof(target)) {}
    back_insert_iterator& operator=(const typename C::value_type& value) { container->push_back(value);return *this; }
    back_insert_iterator& operator=(typename C::value_type&& value) { container->push_back(std::move(value));return *this; }
    back_insert_iterator& operator*() { return *this; }
    back_insert_iterator& operator++() { return *this; }
    back_insert_iterator operator++(int) { return *this; }
};
template<class C> back_insert_iterator<C> back_inserter(C& container) { return back_insert_iterator<C>(container); }
template<class C> class front_insert_iterator {
protected:
    C* container;
public:
    typedef C container_type;
    typedef output_iterator_tag iterator_category;
    typedef void value_type;
    typedef void difference_type;
    typedef void pointer;
    typedef void reference;
    explicit front_insert_iterator(C& target):container(std::addressof(target)) {}
    front_insert_iterator& operator=(const typename C::value_type& value) { container->push_front(value);return *this; }
    front_insert_iterator& operator=(typename C::value_type&& value) { container->push_front(std::move(value));return *this; }
    front_insert_iterator& operator*() { return *this; }
    front_insert_iterator& operator++() { return *this; }
    front_insert_iterator operator++(int) { return *this; }
};
template<class C> front_insert_iterator<C> front_inserter(C& container) { return front_insert_iterator<C>(container); }
template<class C> class insert_iterator {
protected:
    C* container;
    typename C::iterator iter;
public:
    typedef C container_type;
    typedef output_iterator_tag iterator_category;
    typedef void value_type;
    typedef void difference_type;
    typedef void pointer;
    typedef void reference;
    insert_iterator(C& target,typename C::iterator position):container(std::addressof(target)),iter(position) {}
    insert_iterator& operator=(const typename C::value_type& value) { iter=container->insert(iter,value);++iter;return *this; }
    insert_iterator& operator=(typename C::value_type&& value) { iter=container->insert(iter,std::move(value));++iter;return *this; }
    insert_iterator& operator*() { return *this; }
    insert_iterator& operator++() { return *this; }
    insert_iterator& operator++(int) { return *this; }
};
template<class C> insert_iterator<C> inserter(C& container,typename C::iterator position) { return insert_iterator<C>(container,position); }
template<class C> constexpr auto begin(C& container) -> decltype(container.begin()) { return container.begin(); }
template<class C> constexpr auto begin(const C& container) -> decltype(container.begin()) { return container.begin(); }
template<class C> constexpr auto end(C& container) -> decltype(container.end()) { return container.end(); }
template<class C> constexpr auto end(const C& container) -> decltype(container.end()) { return container.end(); }
template<class T,size_t N> constexpr T* begin(T (&array)[N]) noexcept { return array; }
template<class T,size_t N> constexpr T* end(T (&array)[N]) noexcept { return array+N; }
template<class C> constexpr auto cbegin(const C& container) -> decltype(std::begin(container)) { return std::begin(container); }
template<class C> constexpr auto cend(const C& container) -> decltype(std::end(container)) { return std::end(container); }
template<class C> constexpr auto rbegin(C& container) -> decltype(container.rbegin()) { return container.rbegin(); }
template<class C> constexpr auto rbegin(const C& container) -> decltype(container.rbegin()) { return container.rbegin(); }
template<class C> constexpr auto rend(C& container) -> decltype(container.rend()) { return container.rend(); }
template<class C> constexpr auto rend(const C& container) -> decltype(container.rend()) { return container.rend(); }
template<class T,size_t N> constexpr reverse_iterator<T*> rbegin(T (&array)[N]) noexcept { return reverse_iterator<T*>(array+N); }
template<class T,size_t N> constexpr reverse_iterator<T*> rend(T (&array)[N]) noexcept { return reverse_iterator<T*>(array); }
template<class T> constexpr reverse_iterator<const T*> rbegin(initializer_list<T> list) { return reverse_iterator<const T*>(list.end()); }
template<class T> constexpr reverse_iterator<const T*> rend(initializer_list<T> list) { return reverse_iterator<const T*>(list.begin()); }
template<class C> constexpr auto crbegin(const C& container) -> decltype(std::rbegin(container)) { return std::rbegin(container); }
template<class C> constexpr auto crend(const C& container) -> decltype(std::rend(container)) { return std::rend(container); }
}
#endif
