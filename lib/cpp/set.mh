#ifndef MINIC_CPP_SET_MH
#define MINIC_CPP_SET_MH
#include "__tree.mh"
#include "algorithm.mh"
namespace std {
template<class Key,class Compare=less<Key>> class set {
    typedef __minic_tree<Key,Key,__minic_identity<Key>,Compare,false> tree_type;
    tree_type tree_;
public:
    typedef Key key_type;
    typedef Key value_type;
    typedef Compare key_compare;
    typedef Compare value_compare;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef const Key& reference;
    typedef const Key& const_reference;
    typedef const Key* pointer;
    typedef const Key* const_pointer;
    typedef typename tree_type::const_iterator iterator;
    typedef typename tree_type::const_iterator const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;
    set():tree_() {}
    explicit set(const Compare& c):tree_(c) {}
    template<class I> set(I first,I last):tree_(){insert(first,last);}
    template<class I> set(I first,I last,const Compare& c):tree_(c){insert(first,last);}
    set(initializer_list<Key> values):tree_(){insert(values.begin(),values.end());}
    set(initializer_list<Key> values,const Compare& c):tree_(c){insert(values.begin(),values.end());}
    set(const set& other):tree_(other.tree_) {}
    set(set&& other):tree_(std::move(other.tree_)) {}
    set& operator=(const set& other){tree_=other.tree_;return *this;}
    set& operator=(set&& other) noexcept(is_nothrow_move_assignable<Compare>::value) {tree_=std::move(other.tree_);return *this;}
    set& operator=(initializer_list<Key> values){clear();insert(values);return *this;}
    iterator begin() const noexcept {return tree_.begin();} iterator end() const noexcept {return tree_.end();}
    const_iterator cbegin() const noexcept {return begin();} const_iterator cend() const noexcept {return end();}
    reverse_iterator rbegin() const noexcept {return reverse_iterator(end());}
    reverse_iterator rend() const noexcept {return reverse_iterator(begin());}
    const_reverse_iterator crbegin() const noexcept {return rbegin();} const_reverse_iterator crend() const noexcept {return rend();}
    bool empty() const noexcept {return tree_.empty();} size_type size() const noexcept {return tree_.size();}
    size_type max_size() const noexcept {return tree_.max_size();}
    void clear() noexcept {tree_.clear();}
    pair<iterator,bool> insert(const Key& value){pair<typename tree_type::iterator,bool> r=tree_.emplace(value);return pair<iterator,bool>(r.first,r.second);}
    pair<iterator,bool> insert(Key&& value){pair<typename tree_type::iterator,bool> r=tree_.emplace(std::move(value));return pair<iterator,bool>(r.first,r.second);}
    iterator insert(const_iterator hint,const Key& value){return tree_.emplace_hint(hint,value);}
    iterator insert(const_iterator hint,Key&& value){return tree_.emplace_hint(hint,std::move(value));}
    template<class I> void insert(I first,I last){while(first!=last){insert(end(),*first);++first;}}
    void insert(initializer_list<Key> values){insert(values.begin(),values.end());}
    template<class... A> pair<iterator,bool> emplace(A&&... a){pair<typename tree_type::iterator,bool> r=tree_.emplace(std::forward<A>(a)...);return pair<iterator,bool>(r.first,r.second);}
    template<class... A> iterator emplace_hint(const_iterator hint,A&&... a){return tree_.emplace_hint(hint,std::forward<A>(a)...);}
    iterator erase(const_iterator i){return tree_.erase(i);}
    iterator erase(const_iterator first,const_iterator last){return tree_.erase(first,last);}
    size_type erase(const Key& key){return tree_.erase(key);}
    void swap(set& other) noexcept(is_nothrow_swappable<Compare>::value) {tree_.swap(other.tree_);}
    size_type count(const Key& key) const{return tree_.count(key);}
    iterator find(const Key& key) const{return tree_.find(key);}
    iterator lower_bound(const Key& key) const{return tree_.lower_bound(key);}
    iterator upper_bound(const Key& key) const{return tree_.upper_bound(key);}
    pair<iterator,iterator> equal_range(const Key& key) const{return pair<iterator,iterator>(lower_bound(key),upper_bound(key));}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> size_type count(const K& key) const{return tree_.count(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> iterator find(const K& key){return tree_.find(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> const_iterator find(const K& key) const{return tree_.find(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> iterator lower_bound(const K& key){return tree_.lower_bound(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> const_iterator lower_bound(const K& key) const{return tree_.lower_bound(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> iterator upper_bound(const K& key){return tree_.upper_bound(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> const_iterator upper_bound(const K& key) const{return tree_.upper_bound(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> pair<iterator,iterator> equal_range(const K& key){return pair<iterator,iterator>(lower_bound(key),upper_bound(key));}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> pair<const_iterator,const_iterator> equal_range(const K& key) const{return pair<const_iterator,const_iterator>(lower_bound(key),upper_bound(key));}
    Compare key_comp() const{return tree_.key_comp();} Compare value_comp() const{return tree_.key_comp();}
};
template<class K,class C> void swap(set<K,C>& a,set<K,C>& b) noexcept(noexcept(a.swap(b))) {a.swap(b);}
template<class K,class C> bool operator==(const set<K,C>& a,const set<K,C>& b){return a.size()==b.size() && std::equal(a.begin(),a.end(),b.begin());}
template<class K,class C> bool operator!=(const set<K,C>& a,const set<K,C>& b){return !(a==b);}
template<class K,class C> bool operator<(const set<K,C>& a,const set<K,C>& b){return std::lexicographical_compare(a.begin(),a.end(),b.begin(),b.end());}
template<class K,class C> bool operator>(const set<K,C>& a,const set<K,C>& b){return b<a;}
template<class K,class C> bool operator<=(const set<K,C>& a,const set<K,C>& b){return !(b<a);}
template<class K,class C> bool operator>=(const set<K,C>& a,const set<K,C>& b){return !(a<b);}
template<class Key,class Compare=less<Key>> class multiset {
    typedef __minic_tree<Key,Key,__minic_identity<Key>,Compare,true> tree_type;
    tree_type tree_;
public:
    typedef Key key_type;
    typedef Key value_type;
    typedef Compare key_compare;
    typedef Compare value_compare;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef const Key& reference;
    typedef const Key& const_reference;
    typedef const Key* pointer;
    typedef const Key* const_pointer;
    typedef typename tree_type::const_iterator iterator;
    typedef typename tree_type::const_iterator const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;
    multiset():tree_() {}
    explicit multiset(const Compare& c):tree_(c) {}
    template<class I> multiset(I first,I last):tree_(){insert(first,last);}
    template<class I> multiset(I first,I last,const Compare& c):tree_(c){insert(first,last);}
    multiset(initializer_list<Key> values):tree_(){insert(values.begin(),values.end());}
    multiset(initializer_list<Key> values,const Compare& c):tree_(c){insert(values.begin(),values.end());}
    multiset(const multiset& other):tree_(other.tree_) {}
    multiset(multiset&& other):tree_(std::move(other.tree_)) {}
    multiset& operator=(const multiset& other){tree_=other.tree_;return *this;}
    multiset& operator=(multiset&& other) noexcept(is_nothrow_move_assignable<Compare>::value) {tree_=std::move(other.tree_);return *this;}
    multiset& operator=(initializer_list<Key> values){clear();insert(values);return *this;}
    iterator begin() const noexcept {return tree_.begin();} iterator end() const noexcept {return tree_.end();}
    const_iterator cbegin() const noexcept {return begin();} const_iterator cend() const noexcept {return end();}
    reverse_iterator rbegin() const noexcept {return reverse_iterator(end());}
    reverse_iterator rend() const noexcept {return reverse_iterator(begin());}
    const_reverse_iterator crbegin() const noexcept {return rbegin();} const_reverse_iterator crend() const noexcept {return rend();}
    bool empty() const noexcept {return tree_.empty();} size_type size() const noexcept {return tree_.size();}
    size_type max_size() const noexcept {return tree_.max_size();}
    void clear() noexcept {tree_.clear();}
    iterator insert(const Key& value){return tree_.emplace(value).first;}
    iterator insert(Key&& value){return tree_.emplace(std::move(value)).first;}
    iterator insert(const_iterator hint,const Key& value){return tree_.emplace_hint(hint,value);}
    iterator insert(const_iterator hint,Key&& value){return tree_.emplace_hint(hint,std::move(value));}
    template<class I> void insert(I first,I last){while(first!=last){insert(end(),*first);++first;}}
    void insert(initializer_list<Key> values){insert(values.begin(),values.end());}
    template<class... A> iterator emplace(A&&... a){return tree_.emplace(std::forward<A>(a)...).first;}
    template<class... A> iterator emplace_hint(const_iterator hint,A&&... a){return tree_.emplace_hint(hint,std::forward<A>(a)...);}
    iterator erase(const_iterator i){return tree_.erase(i);}
    iterator erase(const_iterator first,const_iterator last){return tree_.erase(first,last);}
    size_type erase(const Key& key){return tree_.erase(key);}
    void swap(multiset& other) noexcept(is_nothrow_swappable<Compare>::value) {tree_.swap(other.tree_);}
    size_type count(const Key& key) const{return tree_.count(key);}
    iterator find(const Key& key) const{return tree_.find(key);}
    iterator lower_bound(const Key& key) const{return tree_.lower_bound(key);}
    iterator upper_bound(const Key& key) const{return tree_.upper_bound(key);}
    pair<iterator,iterator> equal_range(const Key& key) const{return pair<iterator,iterator>(lower_bound(key),upper_bound(key));}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> size_type count(const K& key) const{return tree_.count(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> iterator find(const K& key){return tree_.find(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> const_iterator find(const K& key) const{return tree_.find(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> iterator lower_bound(const K& key){return tree_.lower_bound(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> const_iterator lower_bound(const K& key) const{return tree_.lower_bound(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> iterator upper_bound(const K& key){return tree_.upper_bound(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> const_iterator upper_bound(const K& key) const{return tree_.upper_bound(key);}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> pair<iterator,iterator> equal_range(const K& key){return pair<iterator,iterator>(lower_bound(key),upper_bound(key));}
    template<class K,class=typename __minic_transparent_lookup<Compare,K>::type> pair<const_iterator,const_iterator> equal_range(const K& key) const{return pair<const_iterator,const_iterator>(lower_bound(key),upper_bound(key));}
    Compare key_comp() const{return tree_.key_comp();} Compare value_comp() const{return tree_.key_comp();}
};
template<class K,class C> void swap(multiset<K,C>& a,multiset<K,C>& b) noexcept(noexcept(a.swap(b))) {a.swap(b);}
template<class K,class C> bool operator==(const multiset<K,C>& a,const multiset<K,C>& b){return a.size()==b.size() && std::equal(a.begin(),a.end(),b.begin());}
template<class K,class C> bool operator!=(const multiset<K,C>& a,const multiset<K,C>& b){return !(a==b);}
template<class K,class C> bool operator<(const multiset<K,C>& a,const multiset<K,C>& b){return std::lexicographical_compare(a.begin(),a.end(),b.begin(),b.end());}
template<class K,class C> bool operator>(const multiset<K,C>& a,const multiset<K,C>& b){return b<a;}
template<class K,class C> bool operator<=(const multiset<K,C>& a,const multiset<K,C>& b){return !(b<a);}
template<class K,class C> bool operator>=(const multiset<K,C>& a,const multiset<K,C>& b){return !(a<b);}
}
#endif
