#ifndef MINIC_CPP_TYPE_TRAITS_MH
#define MINIC_CPP_TYPE_TRAITS_MH
namespace std {
template<class T, T V> struct integral_constant {
    static constexpr T value = V;
    typedef T value_type;
    typedef integral_constant type;
    constexpr operator value_type() const noexcept { return value; }
    constexpr value_type operator()() const noexcept { return value; }
};
template<class T,T V> constexpr T integral_constant<T,V>::value;
typedef integral_constant<bool,true> true_type;
typedef integral_constant<bool,false> false_type;
template<bool B,class T=void> struct enable_if {};
template<class T> struct enable_if<true,T> { typedef T type; };
template<bool B,class T,class F> struct conditional { typedef T type; };
template<class T,class F> struct conditional<false,T,F> { typedef F type; };
template<class T> struct remove_const { typedef T type; };
template<class T> struct remove_const<const T> { typedef T type; };
template<class T> struct remove_volatile { typedef T type; };
template<class T> struct remove_volatile<volatile T> { typedef T type; };
template<class T> struct remove_cv { typedef typename remove_const<typename remove_volatile<T>::type>::type type; };
template<class T> struct add_const { typedef const T type; };
template<class T> struct add_volatile { typedef volatile T type; };
template<class T> struct add_cv { typedef const volatile T type; };
template<class T> struct remove_reference { typedef T type; };
template<class T> struct remove_reference<T&> { typedef T type; };
template<class T> struct remove_reference<T&&> { typedef T type; };
template<class... T> struct __minic_trait_void { typedef void type; };
template<class T,class Enable=void> struct add_lvalue_reference { typedef T type; };
template<class T> struct add_lvalue_reference<T,typename __minic_trait_void<T&>::type> { typedef T& type; };
template<class T,class Enable=void> struct add_rvalue_reference { typedef T type; };
template<class T> struct add_rvalue_reference<T,typename __minic_trait_void<T&&>::type> { typedef T&& type; };
template<class T> typename add_rvalue_reference<T>::type declval() noexcept;
template<class T> struct remove_extent { typedef T type; };
template<class T> struct remove_extent<T[]> { typedef T type; };
template<class T,unsigned long long N> struct remove_extent<T[N]> { typedef T type; };
template<class T,class Enable=void> struct add_pointer { typedef T type; };
template<class T> struct add_pointer<T,typename __minic_trait_void<typename remove_reference<T>::type*>::type> { typedef typename remove_reference<T>::type* type; };
template<class T,class U> struct is_same : public integral_constant<bool,(false)> {};
template<class T> struct is_same<T,T> : public integral_constant<bool,(true)> {};
template<class T> struct is_const : public integral_constant<bool,(false)> {};
template<class T> struct is_const<const T> : public integral_constant<bool,(true)> {};
template<class T> struct is_lvalue_reference : public integral_constant<bool,(false)> {};
template<class T> struct is_lvalue_reference<T&> : public integral_constant<bool,(true)> {};
template<class T> struct is_rvalue_reference : public integral_constant<bool,(false)> {};
template<class T> struct is_rvalue_reference<T&&> : public integral_constant<bool,(true)> {};
template<class T> struct is_reference : public integral_constant<bool,(is_lvalue_reference<T>::value || is_rvalue_reference<T>::value)> {};
template<class T> struct is_void : public integral_constant<bool,(is_same<typename remove_cv<T>::type,void>::value)> {};
template<class T> struct is_array : public integral_constant<bool,(false)> {};
template<class T> struct is_array<T[]> : public integral_constant<bool,(true)> {};
template<class T,unsigned long long N> struct is_array<T[N]> : public integral_constant<bool,(true)> {};
template<class T> struct is_function : public integral_constant<bool,(!is_const<const T>::value && !is_reference<T>::value)> {};
template<class T> struct __minic_integral { static constexpr bool value=false; };
template<> struct __minic_integral<bool> { static constexpr bool value=true; };
template<> struct __minic_integral<char> { static constexpr bool value=true; };
template<> struct __minic_integral<signed char> { static constexpr bool value=true; };
template<> struct __minic_integral<unsigned char> { static constexpr bool value=true; };
template<> struct __minic_integral<short> { static constexpr bool value=true; };
template<> struct __minic_integral<unsigned short> { static constexpr bool value=true; };
template<> struct __minic_integral<int> { static constexpr bool value=true; };
template<> struct __minic_integral<unsigned int> { static constexpr bool value=true; };
template<> struct __minic_integral<long> { static constexpr bool value=true; };
template<> struct __minic_integral<unsigned long> { static constexpr bool value=true; };
template<> struct __minic_integral<long long> { static constexpr bool value=true; };
template<> struct __minic_integral<unsigned long long> { static constexpr bool value=true; };
template<class T> struct is_integral : public integral_constant<bool,(__minic_integral<typename remove_cv<T>::type>::value)> {};
template<class T,class... A> struct is_constructible : public integral_constant<bool,(__is_constructible(T,A...))> {};
// Unknown-bound arrays cannot define the object required by C++17 [meta.unary.prop].
template<class T,class... A> struct is_constructible<T[],A...> : public false_type {};
template<class T,class U> struct is_assignable : public integral_constant<bool,(__is_assignable(T,U))> {};
#ifdef __MINIC__
template<class From,class To> struct is_convertible : public integral_constant<bool,(__is_convertible(From,To))> {};
#else
// The reference compiler need not implement MiniC's intrinsic spelling.
// Form a real implicit function-argument conversion and a valid return type.
template<class T> void __minic_implicit_argument(T);
template<class From,class To,class Returnable=decltype(static_cast<To(*)()>(nullptr)),
         class Convertible=decltype(__minic_implicit_argument<To>(std::declval<From>()))>
true_type __minic_conversion_probe(int);
template<class From,class To> false_type __minic_conversion_probe(...);
template<class From,class To> struct is_convertible : public integral_constant<bool,(is_void<From>::value && is_void<To>::value || decltype(__minic_conversion_probe<From,To>(0))::value)> {};
#endif
template<class T> struct is_default_constructible : public integral_constant<bool,(is_constructible<T>::value)> {};
template<class T> struct is_copy_constructible : public integral_constant<bool,(is_constructible<T,typename add_lvalue_reference<typename add_const<T>::type>::type>::value)> {};
template<class T> struct is_move_constructible : public integral_constant<bool,(is_constructible<T,typename add_rvalue_reference<T>::type>::value)> {};
template<class T> struct is_copy_assignable : public integral_constant<bool,(is_assignable<typename add_lvalue_reference<T>::type,typename add_lvalue_reference<typename add_const<T>::type>::type>::value)> {};
template<class T> struct is_move_assignable : public integral_constant<bool,(is_assignable<typename add_lvalue_reference<T>::type,typename add_rvalue_reference<T>::type>::value)> {};
template<class T,bool Array=is_array<T>::value,bool Function=is_function<T>::value> struct __minic_decay {
    typedef typename remove_cv<T>::type type;
};
template<class T> struct __minic_decay<T,true,false> { typedef typename remove_extent<T>::type* type; };
template<class T> struct __minic_decay<T,false,true> { typedef typename add_pointer<T>::type type; };
template<class T> struct decay { typedef typename __minic_decay<typename remove_reference<T>::type>::type type; };
// A failed operation is rejected before its noexcept operand is instantiated.
template<bool Valid,class T,class... A> struct __minic_nothrow_construct { static constexpr bool value=false; };
template<class T,class... A> struct __minic_nothrow_construct<true,T,A...> { static constexpr bool value=noexcept(T(std::declval<A>()...)); };
template<class T,unsigned long long N> struct __minic_nothrow_construct<true,T[N]> { static constexpr bool value=__minic_nothrow_construct<is_constructible<T>::value,T>::value; };
template<bool Valid,class T,class U> struct __minic_nothrow_assign { static constexpr bool value=false; };
template<class T,class U> struct __minic_nothrow_assign<true,T,U> { static constexpr bool value=noexcept(std::declval<T>()=std::declval<U>()); };
template<class T,class... A> struct is_nothrow_constructible : public integral_constant<bool,(__minic_nothrow_construct<is_constructible<T,A...>::value,T,A...>::value)> {};
template<class T,class U> struct is_nothrow_assignable : public integral_constant<bool,(__minic_nothrow_assign<is_assignable<T,U>::value,T,U>::value)> {};
template<class T> struct is_nothrow_default_constructible : public integral_constant<bool,(is_nothrow_constructible<T>::value)> {};
template<class T> struct is_nothrow_copy_constructible : public integral_constant<bool,(is_nothrow_constructible<T,typename add_lvalue_reference<typename add_const<T>::type>::type>::value)> {};
template<class T> struct is_nothrow_move_constructible : public integral_constant<bool,(is_nothrow_constructible<T,typename add_rvalue_reference<T>::type>::value)> {};
template<class T> struct is_nothrow_copy_assignable : public integral_constant<bool,(is_nothrow_assignable<typename add_lvalue_reference<T>::type,typename add_lvalue_reference<typename add_const<T>::type>::type>::value)> {};
template<class T> struct is_nothrow_move_assignable : public integral_constant<bool,(is_nothrow_assignable<typename add_lvalue_reference<T>::type,typename add_rvalue_reference<T>::type>::value)> {};

// The standard swap candidates participate even when only <type_traits> is included.
template<class T> struct is_swappable;
template<class T> struct is_nothrow_swappable;
template<class T> typename enable_if<is_move_constructible<T>::value && is_move_assignable<T>::value>::type
swap(T& a,T& b) noexcept(is_nothrow_move_constructible<T>::value && is_nothrow_move_assignable<T>::value);
template<class T,unsigned long long N> typename enable_if<is_swappable<T>::value>::type
swap(T (&a)[N],T (&b)[N]) noexcept(is_nothrow_swappable<T>::value);
template<class T,class U,class Forward=decltype(swap(std::declval<T>(),std::declval<U>())),
         class Backward=decltype(swap(std::declval<U>(),std::declval<T>()))> true_type __minic_swap_probe(int);
template<class T,class U> false_type __minic_swap_probe(...);
template<bool Valid,class T,class U> struct __minic_nothrow_swap { static constexpr bool value=false; };
template<class T,class U> struct __minic_nothrow_swap<true,T,U> {
    static constexpr bool value=noexcept(swap(std::declval<T>(),std::declval<U>())) && noexcept(swap(std::declval<U>(),std::declval<T>()));
};
template<class T,class U> struct is_swappable_with : public integral_constant<bool,(decltype(__minic_swap_probe<T,U>(0))::value)> {};
template<class T,class U> struct is_nothrow_swappable_with : public integral_constant<bool,(__minic_nothrow_swap<is_swappable_with<T,U>::value,T,U>::value)> {};
template<class T> struct is_swappable : public integral_constant<bool,(is_swappable_with<typename add_lvalue_reference<T>::type,typename add_lvalue_reference<T>::type>::value)> {};
template<class T> struct is_nothrow_swappable : public integral_constant<bool,(is_nothrow_swappable_with<typename add_lvalue_reference<T>::type,typename add_lvalue_reference<T>::type>::value)> {};

}
#endif
