/* MiniC compatibility declarations for <stddef.h>. */
#ifndef MINIC_STDDEF_MH
#define MINIC_STDDEF_MH

/* Windows x64 LLP64 core types. */
typedef unsigned long long size_t;
typedef long long ptrdiff_t;
typedef unsigned short wchar_t;

/* Eight bytes is MiniC's greatest supported fundamental alignment. */
typedef double max_align_t;

#define NULL ((void *)0)
#define offsetof(type, member) ((size_t)&(((type *)0)->member))

/*
 * Intentionally absent: nullptr_t, unreachable, and
 * __STDC_VERSION_STDDEF_H__. MiniC does not yet implement the corresponding
 * C23 language and control-flow semantics.
 */
#endif
