/* Craken compatibility declarations for <stdio.h>. */
#ifndef CRAKEN_STDIO_MH
#define CRAKEN_STDIO_MH
#if !defined(__CRAKEN__)
/* A reference compiler owns its FILE ABI and C linkage. */
#include <stdio.h>
#else
#define EOF (-1)

// Keep the CRT stream representation incomplete; only pointers cross the ABI.
struct __craken_file;
typedef struct __craken_file FILE;
/* Windows x64 legacy MSVCRT: __iob_func returns contiguous 48-byte _iobufs.
 * FILE remains opaque; only this ABI adapter performs the byte offsets.
 * All operations and printf/scanf use the same CRT and its stream buffers. */
extern void *craken_iob_base(void);
#define stdin ((FILE *)craken_iob_base())
#define stdout ((FILE *)((char *)craken_iob_base() + 48))
#define stderr ((FILE *)((char *)craken_iob_base() + 96))
extern int fgetc(FILE *stream);
extern int fputc(int character, FILE *stream);
extern int ungetc(int character, FILE *stream);
extern int fflush(FILE *stream);

extern int printf(const char *format, ...);
extern int scanf(const char *format, ...);
extern int getchar(void);
extern int putchar(int character);
extern int puts(const char *string);
extern int sprintf(char *buffer, const char *format, ...);
extern int sscanf(const char *buffer, const char *format, ...);
extern int remove(const char *filename);
extern int rename(const char *oldName, const char *newName);

/* snprintf is deferred: MSVCRT _snprintf has incompatible truncation semantics. */
#endif
#endif
