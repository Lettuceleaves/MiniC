/* Craken compatibility declarations for <stdlib.h>. */
#ifndef CRAKEN_STDLIB_MH
#define CRAKEN_STDLIB_MH
#if !defined(__CRAKEN__)
#include <stdlib.h>
#else
#include <errno.h>
#define EXIT_SUCCESS 0
#define EXIT_FAILURE 1
#define RAND_MAX 32767
extern void *malloc(unsigned long long size);
extern void *calloc(unsigned long long count, unsigned long long size);
extern void *realloc(void *pointer, unsigned long long size);
extern void free(void *pointer);
extern double atof(const char *string);
extern int atoi(const char *string);
extern long atol(const char *string);
extern long long atoll(const char *string);
extern double craken_ucrt_strtod(const char *string, char **endPointer);
extern float craken_ucrt_strtof(const char *string, char **endPointer);
extern int *craken_ucrt_errno_location(void);
/* MSVCRT lacks strtof. UCRT performs one correctly rounded float conversion;
 * transport its errno into this profile's MSVCRT errno without changing errno
 * on success or leaving the other CRT's thread-local error slot modified. */
/* UCRT also supplies the C99 hexadecimal, infinity and NaN forms missing
 * from the legacy MSVCRT double conversion. It uses UCRT's independent
 * locale (initially C), which is not synchronized with MSVCRT setlocale. */
double strtod(const char *string, char **endPointer) {
    int *foreign_errno = craken_ucrt_errno_location();
    int saved_errno = *foreign_errno;
    *foreign_errno = 0;
    double result = craken_ucrt_strtod(string, endPointer);
    int conversion_errno = *foreign_errno;
    *foreign_errno = saved_errno;
    if (conversion_errno != 0) errno = conversion_errno;
    return result;
}
float strtof(const char *string, char **endPointer) {
    int *foreign_errno = craken_ucrt_errno_location();
    int saved_errno = *foreign_errno;
    *foreign_errno = 0;
    float result = craken_ucrt_strtof(string, endPointer);
    int conversion_errno = *foreign_errno;
    *foreign_errno = saved_errno;
    if (conversion_errno != 0) errno = conversion_errno;
    return result;
}
extern long strtol(const char *string, char **endPointer, int base);
extern long long strtoll(const char *string, char **endPointer, int base);
extern unsigned long strtoul(const char *string, char **endPointer, int base);
extern unsigned long long strtoull(const char *string, char **endPointer, int base);
extern int abs(int value);
extern long labs(long value);
extern long long llabs(long long value);
extern int rand(void);
extern void srand(unsigned int seed);
extern void abort(void);
extern void exit(int status);
extern int craken_immediate_exit(long long processHandle, int status);
#define _Exit(status) craken_immediate_exit(-1LL, (status))
#endif
#endif
