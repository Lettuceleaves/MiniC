#ifndef CRAKEN_STL_TREE_MH
#define CRAKEN_STL_TREE_MH
#include "memory.mh"
#include "iterator.mh"
#include "functional.mh"
#include "initializer_list.mh"
namespace std {
// Defer Compare::is_transparent until the lookup member template is substituted.
// Any valid nested type qualifies, not only a typedef of void.
template<class T> struct __craken_lookup_void { typedef void type; };
template<class Compare,class K,class=void> struct __craken_transparent_lookup {};
template<class Compare,class K> struct __craken_transparent_lookup<Compare,K,
    typename __craken_lookup_void<typename Compare::is_transparent>::type> { typedef void type; };
// Leaves are null. The red header owns the root and caches both extrema.
struct __craken_rb_node {
    __craken_rb_node* parent;
    __craken_rb_node* left;
    __craken_rb_node* right;
    bool red;
    __craken_rb_node():parent(nullptr),left(nullptr),right(nullptr),red(true) {}
};
__craken_rb_node* __craken_rb_min(__craken_rb_node* n) { while(n->left)n=n->left;return n; }
__craken_rb_node* __craken_rb_max(__craken_rb_node* n) { while(n->right)n=n->right;return n; }
bool __craken_rb_red(__craken_rb_node* n) { return n && n->red; }
__craken_rb_node* __craken_rb_next(__craken_rb_node* n) {
    if(n->right)return __craken_rb_min(n->right);
    __craken_rb_node* p=n->parent;
    while(n==p->right){n=p;p=p->parent;}
    if(n->right!=p)n=p;
    return n;
}
__craken_rb_node* __craken_rb_prev(__craken_rb_node* n) {
    if(n->red && n->parent->parent==n)return n->right;
    if(n->left)return __craken_rb_max(n->left);
    __craken_rb_node* p=n->parent;
    while(n==p->left){n=p;p=p->parent;}
    return p;
}
template<class T> size_t __craken_rb_offset() {
    return (sizeof(__craken_rb_node)+alignof(T)-1)/alignof(T)*alignof(T);
}
template<class T> T* __craken_rb_value(__craken_rb_node* n) {
    return (T*)((unsigned char*)n+std::__craken_rb_offset<T>());
}
template<class T,bool Constant> struct __craken_rb_iterator {
    typedef bidirectional_iterator_tag iterator_category;
    typedef T value_type;
    typedef ptrdiff_t difference_type;
    typedef typename conditional<Constant,const T*,T*>::type pointer;
    typedef typename conditional<Constant,const T&,T&>::type reference;
    __craken_rb_node* node;
    __craken_rb_iterator():node(nullptr) {}
    explicit __craken_rb_iterator(__craken_rb_node* n):node(n) {}
    template<bool Other,typename enable_if<Constant || !Other,int>::type = 0>
    __craken_rb_iterator(const __craken_rb_iterator<T,Other>& other):node(other.node) {}
    reference operator*() const { return *std::__craken_rb_value<T>(node); }
    pointer operator->() const { return std::__craken_rb_value<T>(node); }
    __craken_rb_iterator& operator++(){node=std::__craken_rb_next(node);return *this;}
    __craken_rb_iterator operator++(int){__craken_rb_iterator saved=*this;++*this;return saved;}
    __craken_rb_iterator& operator--(){node=std::__craken_rb_prev(node);return *this;}
    __craken_rb_iterator operator--(int){__craken_rb_iterator saved=*this;--*this;return saved;}
    template<bool Other> bool operator==(const __craken_rb_iterator<T,Other>& b) const{return node==b.node;}
    template<bool Other> bool operator!=(const __craken_rb_iterator<T,Other>& b) const{return node!=b.node;}
};
template<class T> struct __craken_identity { const T& operator()(const T& v) const{return v;} };
template<class K,class V> struct __craken_first { const K& operator()(const pair<const K,V>& v) const{return v.first;} };

template<class Key,class Value,class KeyOfValue,class Compare,bool Multi> class __craken_tree {
    __craken_rb_node header_;
    size_t size_;
    Compare compare_;
    void reset(){header_.parent=nullptr;header_.left=&header_;header_.right=&header_;header_.red=true;size_=0;}
    const Key& key(__craken_rb_node* n) const{return KeyOfValue()(*std::__craken_rb_value<Value>(n));}
    void rotate_left(__craken_rb_node* x){
        __craken_rb_node* y=x->right;x->right=y->left;
        if(y->left)y->left->parent=x;
        y->parent=x->parent;
        if(x->parent==&header_)header_.parent=y;
        else if(x==x->parent->left)x->parent->left=y;else x->parent->right=y;
        y->left=x;x->parent=y;
    }
    void rotate_right(__craken_rb_node* x){
        __craken_rb_node* y=x->left;x->left=y->right;
        if(y->right)y->right->parent=x;
        y->parent=x->parent;
        if(x->parent==&header_)header_.parent=y;
        else if(x==x->parent->right)x->parent->right=y;else x->parent->left=y;
        y->right=x;x->parent=y;
    }
    void fix_insert(__craken_rb_node* n){
        while(n!=header_.parent && n->parent->red){
            __craken_rb_node* p=n->parent;__craken_rb_node* g=p->parent;
            if(p==g->left){
                __craken_rb_node* u=g->right;
                if(std::__craken_rb_red(u)){p->red=false;u->red=false;g->red=true;n=g;}
                else{if(n==p->right){n=p;rotate_left(n);p=n->parent;g=p->parent;}p->red=false;g->red=true;rotate_right(g);}
            }else{
                __craken_rb_node* u=g->left;
                if(std::__craken_rb_red(u)){p->red=false;u->red=false;g->red=true;n=g;}
                else{if(n==p->left){n=p;rotate_right(n);p=n->parent;g=p->parent;}p->red=false;g->red=true;rotate_left(g);}
            }
        }
        header_.parent->red=false;
    }
    void transplant(__craken_rb_node* a,__craken_rb_node* b){
        if(a->parent==&header_)header_.parent=b;
        else if(a==a->parent->left)a->parent->left=b;else a->parent->right=b;
        if(b)b->parent=a->parent;
    }
    void fix_erase(__craken_rb_node* x,__craken_rb_node* p){
        while(x!=header_.parent && !std::__craken_rb_red(x)){
            if(x==p->left){
                __craken_rb_node* w=p->right;
                if(std::__craken_rb_red(w)){w->red=false;p->red=true;rotate_left(p);w=p->right;}
                if(!w){x=p;p=p->parent;continue;}
                if(!std::__craken_rb_red(w->left) && !std::__craken_rb_red(w->right)){w->red=true;x=p;p=p->parent;}
                else{
                    if(!std::__craken_rb_red(w->right)){if(w->left)w->left->red=false;w->red=true;rotate_right(w);w=p->right;}
                    w->red=p->red;p->red=false;if(w->right)w->right->red=false;rotate_left(p);x=header_.parent;p=&header_;
                }
            }else{
                __craken_rb_node* w=p->left;
                if(std::__craken_rb_red(w)){w->red=false;p->red=true;rotate_right(p);w=p->left;}
                if(!w){x=p;p=p->parent;continue;}
                if(!std::__craken_rb_red(w->right) && !std::__craken_rb_red(w->left)){w->red=true;x=p;p=p->parent;}
                else{
                    if(!std::__craken_rb_red(w->left)){if(w->right)w->right->red=false;w->red=true;rotate_left(w);w=p->left;}
                    w->red=p->red;p->red=false;if(w->left)w->left->red=false;rotate_right(p);x=header_.parent;p=&header_;
                }
            }
        }
        if(x)x->red=false;
    }
    template<class... A> __craken_rb_node* create(A&&... a){
        size_t bytes=std::__craken_rb_offset<Value>()+sizeof(Value);
        size_t alignment=alignof(Value)>alignof(__craken_rb_node)?alignof(Value):alignof(__craken_rb_node);
        void* storage=std::__craken_allocate_bytes(bytes,alignment);
        __craken_rb_node* n=::new(storage) __craken_rb_node();
        std::__craken_construct(std::__craken_rb_value<Value>(n),std::forward<A>(a)...);
        return n;
    }
    void destroy(__craken_rb_node* n){
        std::__craken_destroy(std::__craken_rb_value<Value>(n));n->~__craken_rb_node();
        size_t alignment=alignof(Value)>alignof(__craken_rb_node)?alignof(Value):alignof(__craken_rb_node);
        std::__craken_deallocate_bytes((void*)n,alignment);
    }
    void destroy_subtree(__craken_rb_node* n){
        // A red-black tree has logarithmic height, so recursion is bounded by its height.
        while(n){destroy_subtree(n->right);__craken_rb_node* left=n->left;destroy(n);n=left;}
    }
    __craken_rb_node* clone_subtree(__craken_rb_node* source,__craken_rb_node* parent){
        if(!source)return nullptr;
        __craken_rb_node* n=create((const Value&)*std::__craken_rb_value<Value>(source));
        n->parent=parent;n->red=source->red;
        n->left=clone_subtree(source->left,n);n->right=clone_subtree(source->right,n);
        return n;
    }
    void take(__craken_tree& other){
        if(other.size_){header_.parent=other.header_.parent;header_.left=other.header_.left;header_.right=other.header_.right;size_=other.size_;header_.parent->parent=&header_;other.reset();}
    }
public:
    typedef __craken_rb_iterator<Value,false> iterator;
    typedef __craken_rb_iterator<Value,true> const_iterator;
    __craken_tree():header_(),size_(0),compare_(){reset();}
    explicit __craken_tree(const Compare& c):header_(),size_(0),compare_(c){reset();}
    __craken_tree(const __craken_tree& other):header_(),size_(0),compare_(other.compare_){
        reset();header_.parent=clone_subtree(other.header_.parent,&header_);size_=other.size_;
        if(size_){header_.left=std::__craken_rb_min(header_.parent);header_.right=std::__craken_rb_max(header_.parent);}
    }
    __craken_tree(__craken_tree&& other):header_(),size_(0),compare_(std::move(other.compare_)){reset();take(other);}
    ~__craken_tree(){clear();}
    __craken_tree& operator=(const __craken_tree& other){if(this!=&other){__craken_tree tmp(other);swap(tmp);}return *this;}
    __craken_tree& operator=(__craken_tree&& other) noexcept(is_nothrow_move_assignable<Compare>::value) {if(this!=&other){clear();compare_=std::move(other.compare_);take(other);}return *this;}
    iterator begin() noexcept {return iterator(header_.left);} const_iterator begin() const noexcept {return const_iterator(header_.left);}
    iterator end() noexcept {return iterator(&header_);} const_iterator end() const noexcept {return const_iterator((__craken_rb_node*)&header_);}
    bool empty() const noexcept {return size_==0;} size_t size() const noexcept {return size_;}
    size_t max_size() const noexcept {return 0x7fffffffffffffffULL/(std::__craken_rb_offset<Value>()+sizeof(Value));}
    Compare key_comp() const{return compare_;}
private:
    pair<iterator,bool> attach(__craken_rb_node* n,__craken_rb_node* p,bool left){
        n->parent=p;
        if(p==&header_){header_.parent=n;header_.left=n;header_.right=n;}
        else if(left){p->left=n;if(p==header_.left)header_.left=n;}
        else{p->right=n;if(p==header_.right)header_.right=n;}
        ++size_;fix_insert(n);return pair<iterator,bool>(iterator(n),true);
    }
    pair<iterator,bool> insert_node(__craken_rb_node* n){
        __craken_rb_node* p=&header_;__craken_rb_node* current=header_.parent;bool left=true;
        while(current){
            p=current;left=compare_(key(n),key(current));
            if(!Multi && !left && !compare_(key(current),key(n))){destroy(n);return pair<iterator,bool>(iterator(current),false);}
            current=left?current->left:current->right;
        }
        return attach(n,p,left);
    }
public:
    template<class... A> pair<iterator,bool> emplace(A&&... a){return insert_node(create(std::forward<A>(a)...));}
    template<class... A> iterator emplace_hint(const_iterator hint,A&&... a){
        __craken_rb_node* n=create(std::forward<A>(a)...);__craken_rb_node* h=hint.node;
        if(size_==0)return attach(n,&header_,true).first;
        if(h==&header_){
            if(Multi?!compare_(key(n),key(header_.right)):compare_(key(header_.right),key(n)))return attach(n,header_.right,false).first;
            if(!Multi && !compare_(key(n),key(header_.right))){destroy(n);return iterator(header_.right);}
        }else{
            bool before=Multi?!compare_(key(h),key(n)):compare_(key(n),key(h));
            if(before){
                if(h==header_.left)return attach(n,h,true).first;
                __craken_rb_node* previous=std::__craken_rb_prev(h);
                if(Multi?!compare_(key(n),key(previous)):compare_(key(previous),key(n))){
                    if(!previous->right)return attach(n,previous,false).first;
                    return attach(n,h,true).first;
                }
            }else if(!Multi && !compare_(key(h),key(n))){destroy(n);return iterator(h);}
        }
        return insert_node(n).first;
    }
    template<class K> iterator lower_bound(const K& k){
        __craken_rb_node* n=header_.parent;__craken_rb_node* found=&header_;
        while(n){if(!compare_(key(n),k)){found=n;n=n->left;}else n=n->right;}return iterator(found);
    }
    template<class K> const_iterator lower_bound(const K& k) const{
        __craken_rb_node* n=header_.parent;__craken_rb_node* found=(__craken_rb_node*)&header_;
        while(n){if(!compare_(key(n),k)){found=n;n=n->left;}else n=n->right;}return const_iterator(found);
    }
    template<class K> iterator upper_bound(const K& k){
        __craken_rb_node* n=header_.parent;__craken_rb_node* found=&header_;
        while(n){if(compare_(k,key(n))){found=n;n=n->left;}else n=n->right;}return iterator(found);
    }
    template<class K> const_iterator upper_bound(const K& k) const{
        __craken_rb_node* n=header_.parent;__craken_rb_node* found=(__craken_rb_node*)&header_;
        while(n){if(compare_(k,key(n))){found=n;n=n->left;}else n=n->right;}return const_iterator(found);
    }
    template<class K> iterator find(const K& k){iterator i=lower_bound(k);return i==end() || compare_(k,key(i.node))?end():i;}
    // A correct insertion hint proves absence between its predecessor and itself.
    // Look up before constructing mapped values so a duplicate never consumes args.
    template<class K> iterator find_with_hint(const_iterator hint,const K& k){
        if(size_==0)return end();
        __craken_rb_node* h=hint.node;
        if(h==&header_){
            if(compare_(key(header_.right),k))return end();
            if(!compare_(k,key(header_.right)))return iterator(header_.right);
        }else if(compare_(k,key(h))){
            if(h==header_.left)return end();
            __craken_rb_node* previous=std::__craken_rb_prev(h);
            if(compare_(key(previous),k))return end();
            if(!compare_(k,key(previous)))return iterator(previous);
        }else if(!compare_(key(h),k))return iterator(h);
        return find(k);
    }
    template<class K> const_iterator find(const K& k) const{const_iterator i=lower_bound(k);return i==end() || compare_(k,key(i.node))?end():i;}
    template<class K> size_t count(const K& k) const{const_iterator first=lower_bound(k),last=upper_bound(k);return std::distance(first,last);}
    iterator erase(const_iterator position){
        __craken_rb_node* z=position.node;iterator result(std::__craken_rb_next(z));
        if(z==header_.left)header_.left=result.node;
        if(z==header_.right)header_.right=std::__craken_rb_prev(z);
        __craken_rb_node* y=z;__craken_rb_node* x=nullptr;__craken_rb_node* parent=nullptr;bool red=y->red;
        if(!z->left){x=z->right;parent=z->parent;transplant(z,z->right);}
        else if(!z->right){x=z->left;parent=z->parent;transplant(z,z->left);}
        else{
            y=std::__craken_rb_min(z->right);red=y->red;x=y->right;
            if(y->parent==z){parent=y;if(x)x->parent=y;}
            else{parent=y->parent;transplant(y,y->right);y->right=z->right;y->right->parent=y;}
            transplant(z,y);y->left=z->left;y->left->parent=y;y->red=z->red;
        }
        --size_;if(!red)fix_erase(x,parent);
        if(!header_.parent){header_.left=&header_;header_.right=&header_;}
        destroy(z);return result;
    }
    iterator erase(const_iterator first,const_iterator last){while(first!=last)first=erase(first);return iterator(last.node);}
    size_t erase(const Key& k){size_t old=size_;erase(lower_bound(k),upper_bound(k));return old-size_;}
    void clear() noexcept {destroy_subtree(header_.parent);reset();}
    void swap(__craken_tree& other) noexcept(is_nothrow_swappable<Compare>::value) {
        if(this==&other)return;
        using std::swap;swap(compare_,other.compare_);swap(size_,other.size_);
        swap(header_.parent,other.header_.parent);swap(header_.left,other.header_.left);swap(header_.right,other.header_.right);
        if(size_)header_.parent->parent=&header_;else{header_.left=&header_;header_.right=&header_;}
        if(other.size_)other.header_.parent->parent=&other.header_;else{other.header_.left=&other.header_;other.header_.right=&other.header_;}
    }
};
}
#endif
