#ifndef CRAKEN_STL_CSTDLIB_MH
#define CRAKEN_STL_CSTDLIB_MH
#include <stdlib.h>
#include <math.h>
namespace std {
using ::malloc;
using ::calloc;
using ::realloc;
using ::free;
using ::atof;
using ::atoi;
using ::atol;
using ::atoll;
using ::strtod;
using ::strtof;
using ::strtol;
using ::strtoll;
using ::strtoul;
using ::strtoull;
using ::abs;
using ::labs;
using ::llabs;
using ::rand;
using ::srand;
using ::abort;
using ::exit;
#if defined(__CRAKEN__) || defined(__CRAKEN_SELF_STL__)
float abs(float value){return (float)::fabs((double)value);}
double abs(double value){return ::fabs(value);}
long double abs(long double value){return (long double)::fabs((double)value);}
long abs(long value){return ::labs(value);}
long long abs(long long value){return ::llabs(value);}
#endif
}
#endif
