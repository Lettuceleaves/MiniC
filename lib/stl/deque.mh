#ifndef CRAKEN_STL_DEQUE_MH
#define CRAKEN_STL_DEQUE_MH
#include "memory.mh"
#include "iterator.mh"
#include "initializer_list.mh"
namespace std {

// Iterators refer to block-map entries, never to the container object. A map
// reallocation invalidates iterators but leaves every element at its address.
template<class T,bool Constant> class __craken_deque_iterator {
public:
    typedef T value_type;
    typedef long long difference_type;
    typedef typename conditional<Constant,const T*,T*>::type pointer;
    typedef typename conditional<Constant,const T&,T&>::type reference;
    typedef random_access_iterator_tag iterator_category;
    T** __node;
    difference_type __offset;
    static difference_type __block_size() { return sizeof(T)<512?512/sizeof(T):1; }
    __craken_deque_iterator():__node(nullptr),__offset(0) {}
    __craken_deque_iterator(T** node,difference_type offset):__node(node),__offset(offset) {}
    template<bool Other,class Enable=typename enable_if<Constant || !Other>::type>
    __craken_deque_iterator(const __craken_deque_iterator<T,Other>& other):__node(other.__node),__offset(other.__offset) {}
    reference operator*() const { return (*__node)[__offset]; }
    pointer operator->() const { return (*__node)+__offset; }
    __craken_deque_iterator& operator++() { ++__offset;if(__offset==__block_size()){++__node;__offset=0;}return *this; }
    __craken_deque_iterator operator++(int) { __craken_deque_iterator saved=*this;++*this;return saved; }
    __craken_deque_iterator& operator--() { if(__offset==0){--__node;__offset=__block_size();}--__offset;return *this; }
    __craken_deque_iterator operator--(int) { __craken_deque_iterator saved=*this;--*this;return saved; }
    __craken_deque_iterator& operator+=(difference_type n) {
        difference_type blocks=n/__block_size();
        difference_type offset=__offset+n%__block_size();
        if(offset<0){--blocks;offset+=__block_size();}
        else if(offset>=__block_size()){++blocks;offset-=__block_size();}
        if(blocks!=0)__node+=blocks;__offset=offset;return *this;
    }
    __craken_deque_iterator& operator-=(difference_type n) {
        // Split first, avoiding negation of the most negative difference_type.
        difference_type blocks=n/__block_size();
        difference_type rest=n%__block_size();
        if(blocks!=0)__node-=blocks;return *this+=-rest;
    }
    __craken_deque_iterator operator+(difference_type n) const { __craken_deque_iterator result=*this;result+=n;return result; }
    __craken_deque_iterator operator-(difference_type n) const { __craken_deque_iterator result=*this;result-=n;return result; }
    reference operator[](difference_type n) const { return *(*this+n); }
    template<bool Other> difference_type operator-(const __craken_deque_iterator<T,Other>& other) const {
        if(__node==other.__node)return __offset-other.__offset;
        return (__node-other.__node)*__block_size()+__offset-other.__offset;
    }
    template<bool Other> bool operator==(const __craken_deque_iterator<T,Other>& other) const { return __node==other.__node && __offset==other.__offset; }
    template<bool Other> bool operator!=(const __craken_deque_iterator<T,Other>& other) const { return !(*this==other); }
    template<bool Other> bool operator<(const __craken_deque_iterator<T,Other>& other) const { return __node==other.__node?__offset<other.__offset:__node<other.__node; }
    template<bool Other> bool operator>(const __craken_deque_iterator<T,Other>& other) const { return other<*this; }
    template<bool Other> bool operator<=(const __craken_deque_iterator<T,Other>& other) const { return !(other<*this); }
    template<bool Other> bool operator>=(const __craken_deque_iterator<T,Other>& other) const { return !(*this<other); }
};
template<class T,bool C> __craken_deque_iterator<T,C> operator+(long long n,const __craken_deque_iterator<T,C>& it) { return it+n; }

template<class T> class deque {
    T** map_;
    unsigned long long map_capacity_;
    unsigned long long first_;
    unsigned long long offset_;
    unsigned long long size_;
    static unsigned long long block_size() { return sizeof(T)<512?512/sizeof(T):1; }
    unsigned long long active_blocks() const { return size_?(offset_+size_-1)/block_size()+1:0; }
    void check_growth(unsigned long long n) const { if(n>max_size()-size_)::abort(); }
    void replace_map(unsigned long long capacity,unsigned long long front_blocks,unsigned long long back_blocks) {
        unsigned long long active=active_blocks();
        unsigned long long required=active+front_blocks+back_blocks+2;
        if(capacity<required)capacity=required;
        T** next=std::__craken_allocate<T*>(capacity);
        for(unsigned long long i=0;i<capacity;++i)next[i]=nullptr;
        unsigned long long first=front_blocks+(capacity-required)/2;
        for(unsigned long long i=0;i<active;++i)next[first+i]=map_[first_+i];
        std::__craken_deallocate(map_);map_=next;map_capacity_=capacity;first_=first;
    }
    void ensure_map(unsigned long long front_blocks,unsigned long long back_blocks) {
        if(map_!=nullptr && first_>=front_blocks
                && map_capacity_-first_-active_blocks()>back_blocks)return;
        unsigned long long capacity=map_capacity_?map_capacity_*2:8;
        if(capacity<map_capacity_)::abort();
        replace_map(capacity,front_blocks,back_blocks);
    }
    T* slot(unsigned long long index) const {
        unsigned long long absolute=offset_+index;
        return map_[first_+absolute/block_size()]+absolute%block_size();
    }
    void reserve_back_slots(unsigned long long n) {
        if(n==0)return;check_growth(n);
        unsigned long long blocks=(offset_+size_+n-1)/block_size()+1;
        unsigned long long active=active_blocks();
        ensure_map(0,blocks-active);
        for(unsigned long long i=active;i<blocks;++i)if(map_[first_+i]==nullptr)map_[first_+i]=std::__craken_allocate<T>(block_size());
    }
    void reserve_front_slots(unsigned long long n) {
        if(n==0)return;check_growth(n);
        unsigned long long active=active_blocks();
        unsigned long long blocks=n>offset_?(n-offset_-1)/block_size()+1:0;
        ensure_map(blocks,0);
        first_-=blocks;offset_=blocks*block_size()+offset_-n;
        unsigned long long used=(offset_+size_+n-1)/block_size()+1;
        // The existing active blocks follow this new prefix and remain allocated.
        // In an empty deque, used-active also includes its first partial block.
        for(unsigned long long i=0;i<used-active;++i)if(map_[first_+i]==nullptr)map_[first_+i]=std::__craken_allocate<T>(block_size());
    }
    void release_last_block() {
        std::__craken_deallocate(map_[first_]);map_[first_]=nullptr;
        first_=map_capacity_/2;offset_=block_size()/2;
    }
    unsigned long long position(const __craken_deque_iterator<T,true>& it) const { return (unsigned long long)(it-cbegin()); }
    __craken_deque_iterator<T,false> insert_buffer(unsigned long long index,deque& values) {
        unsigned long long n=values.size_;if(n==0)return begin()+(long long)index;
        check_growth(n);unsigned long long old=size_;
        if(index<old-index) {
            reserve_front_slots(n);
            for(unsigned long long i=0;i<index;++i){if(i<n)std::__craken_construct(slot(i),std::move(*slot(i+n)));else *slot(i)=std::move(*slot(i+n));}
            for(unsigned long long i=0;i<n;++i){unsigned long long at=index+i;if(at<n)std::__craken_construct(slot(at),std::move(values[i]));else *slot(at)=std::move(values[i]);}
        } else {
            reserve_back_slots(n);
            for(unsigned long long i=old;i>index;){--i;unsigned long long at=i+n;if(at>=old)std::__craken_construct(slot(at),std::move(*slot(i)));else *slot(at)=std::move(*slot(i));}
            for(unsigned long long i=0;i<n;++i){unsigned long long at=index+i;if(at>=old)std::__craken_construct(slot(at),std::move(values[i]));else *slot(at)=std::move(values[i]);}
        }
        size_=old+n;return begin()+(long long)index;
    }
public:
    typedef T value_type;
    typedef unsigned long long size_type;
    typedef long long difference_type;
    typedef T& reference;
    typedef const T& const_reference;
    typedef T* pointer;
    typedef const T* const_pointer;
    typedef __craken_deque_iterator<T,false> iterator;
    typedef __craken_deque_iterator<T,true> const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;
    deque():map_(nullptr),map_capacity_(0),first_(0),offset_(block_size()/2),size_(0) {}
    explicit deque(size_type n):map_(nullptr),map_capacity_(0),first_(0),offset_(block_size()/2),size_(0) { resize(n); }
    deque(size_type n,const T& value):map_(nullptr),map_capacity_(0),first_(0),offset_(block_size()/2),size_(0) { while(n>0){push_back(value);--n;} }
    template<class I,class Enable=typename enable_if<!is_integral<I>::value>::type>
    deque(I first,I last):map_(nullptr),map_capacity_(0),first_(0),offset_(block_size()/2),size_(0) { while(first!=last){emplace_back(*first);++first;} }
    deque(initializer_list<T> values):map_(nullptr),map_capacity_(0),first_(0),offset_(block_size()/2),size_(0) { for(const T* it=values.begin();it!=values.end();++it)push_back(*it); }
    deque(const deque& other):map_(nullptr),map_capacity_(0),first_(0),offset_(block_size()/2),size_(0) { for(size_type i=0;i<other.size_;++i)push_back(other[i]); }
    deque(deque&& other):map_(other.map_),map_capacity_(other.map_capacity_),first_(other.first_),offset_(other.offset_),size_(other.size_) {
        other.map_=nullptr;other.map_capacity_=0;other.first_=0;other.offset_=block_size()/2;other.size_=0;
    }
    ~deque() { clear();std::__craken_deallocate(map_); }
    deque& operator=(const deque& other) { if(this!=&other){deque copy(other);swap(copy);}return *this; }
    deque& operator=(deque&& other) noexcept {
        if(this!=&other){clear();std::__craken_deallocate(map_);map_=other.map_;map_capacity_=other.map_capacity_;first_=other.first_;offset_=other.offset_;size_=other.size_;other.map_=nullptr;other.map_capacity_=0;other.first_=0;other.offset_=block_size()/2;other.size_=0;}return *this;
    }
    deque& operator=(initializer_list<T> values) { assign(values);return *this; }
    iterator begin() noexcept { return iterator(map_?map_+first_:nullptr,(difference_type)offset_); }
    const_iterator begin() const noexcept { return const_iterator(map_?map_+first_:nullptr,(difference_type)offset_); }
    const_iterator cbegin() const noexcept { return begin(); }
    iterator end() noexcept { return begin()+(difference_type)size_; }
    const_iterator end() const noexcept { return begin()+(difference_type)size_; }
    const_iterator cend() const noexcept { return end(); }
    reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
    const_reverse_iterator rbegin() const noexcept { return const_reverse_iterator(end()); }
    const_reverse_iterator crbegin() const noexcept { return const_reverse_iterator(cend()); }
    reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
    const_reverse_iterator rend() const noexcept { return const_reverse_iterator(begin()); }
    const_reverse_iterator crend() const noexcept { return const_reverse_iterator(cbegin()); }
    bool empty() const noexcept { return size_==0; }
    size_type size() const noexcept { return size_; }
    size_type max_size() const noexcept { return 0x3fffffffffffffffULL/sizeof(T); }
    reference operator[](size_type index) { return *slot(index); }
    const_reference operator[](size_type index) const { return *slot(index); }
    reference at(size_type index) { if(index>=size_)::abort();return *slot(index); }
    const_reference at(size_type index) const { if(index>=size_)::abort();return *slot(index); }
    reference front() { return map_[first_][offset_]; }
    const_reference front() const { return map_[first_][offset_]; }
    reference back() { return *slot(size_-1); }
    const_reference back() const { return *slot(size_-1); }
    template<class... A> reference emplace_back(A&&... args) {
        size_type absolute=offset_+size_,within=absolute%block_size();
        if(size_!=0 && within!=0)check_growth(1);else reserve_back_slots(1);
        T* target=map_[first_+absolute/block_size()]+within;
        std::__craken_construct(target,std::forward<A>(args)...);++size_;return *target;
    }
    template<class... A> reference emplace_front(A&&... args) {
        if(size_!=0 && offset_!=0){check_growth(1);--offset_;}else reserve_front_slots(1);
        T* target=map_[first_]+offset_;
        std::__craken_construct(target,std::forward<A>(args)...);++size_;return *target;
    }
    void push_back(const T& value) { emplace_back(value); }
    void push_back(T&& value) { emplace_back(std::move(value)); }
    void push_front(const T& value) { emplace_front(value); }
    void push_front(T&& value) { emplace_front(std::move(value)); }
    void pop_back() {
        --size_;size_type end=offset_+size_,within=end%block_size(),block=first_+end/block_size();
        std::__craken_destroy(map_[block]+within);
        if(size_==0){release_last_block();return;}
        if(within==0){std::__craken_deallocate(map_[block]);map_[block]=nullptr;}
    }
    void pop_front() {
        std::__craken_destroy(map_[first_]+offset_);--size_;++offset_;
        if(size_==0){release_last_block();return;}
        if(offset_==block_size()){std::__craken_deallocate(map_[first_]);map_[first_]=nullptr;++first_;offset_=0;}
    }
    void clear() noexcept { while(size_>0)pop_back(); }
    void shrink_to_fit() { if(size_==0){std::__craken_deallocate(map_);map_=nullptr;map_capacity_=0;first_=0;offset_=block_size()/2;}else replace_map(active_blocks()+2,0,0); }
    void resize(size_type n) { if(n>max_size())::abort();while(size_>n)pop_back();while(size_<n)emplace_back(); }
    void resize(size_type n,const T& value) { if(n>max_size())::abort();if(n>size_){T saved=value;while(size_<n)push_back(saved);}else while(size_>n)pop_back(); }
    template<class... A> iterator emplace(const_iterator where,A&&... args) {
        size_type index=position(where);
        if(index==0){emplace_front(std::forward<A>(args)...);return begin();}
        if(index==size_){emplace_back(std::forward<A>(args)...);return begin()+(difference_type)index;}
        T saved(std::forward<A>(args)...);
        if(index<size_-index){emplace_front(std::move(front()));for(size_type i=1;i<index;++i)(*this)[i]=std::move((*this)[i+1]);}
        else {emplace_back(std::move(back()));for(size_type i=size_-2;i>index;--i)(*this)[i]=std::move((*this)[i-1]);}
        (*this)[index]=std::move(saved);return begin()+(difference_type)index;
    }
    iterator insert(const_iterator where,const T& value) { return emplace(where,value); }
    iterator insert(const_iterator where,T&& value) { return emplace(where,std::move(value)); }
    iterator insert(const_iterator where,size_type count,const T& value) { size_type index=position(where);check_growth(count);if(count==0)return begin()+(difference_type)index;deque saved(count,value);return insert_buffer(index,saved); }
    template<class I,class Enable=typename enable_if<!is_integral<I>::value>::type>
    iterator insert(const_iterator where,I first,I last) { size_type index=position(where);deque saved(first,last);return insert_buffer(index,saved); }
    iterator insert(const_iterator where,initializer_list<T> values) { return insert(where,values.begin(),values.end()); }
    iterator erase(const_iterator where) { return erase(where,where+1); }
    iterator erase(const_iterator first,const_iterator last) {
        size_type index=position(first),finish=position(last),n=finish-index;
        if(n==0)return begin()+(difference_type)index;
        if(index<size_-finish){for(size_type i=index;i>0;--i)(*this)[i+n-1]=std::move((*this)[i-1]);for(size_type i=0;i<n;++i)pop_front();}
        else {for(size_type i=finish;i<size_;++i)(*this)[i-n]=std::move((*this)[i]);for(size_type i=0;i<n;++i)pop_back();}
        return begin()+(difference_type)index;
    }
    void assign(size_type count,const T& value) { deque saved(count,value);swap(saved); }
    template<class I,class Enable=typename enable_if<!is_integral<I>::value>::type>
    void assign(I first,I last) { deque saved(first,last);swap(saved); }
    void assign(initializer_list<T> values) { assign(values.begin(),values.end()); }
    void swap(deque& other) noexcept { std::swap(map_,other.map_);std::swap(map_capacity_,other.map_capacity_);std::swap(first_,other.first_);std::swap(offset_,other.offset_);std::swap(size_,other.size_); }
};
template<class T> void swap(deque<T>& a,deque<T>& b) noexcept(noexcept(a.swap(b))) { a.swap(b); }
template<class T> bool operator==(const deque<T>& a,const deque<T>& b) { if(a.size()!=b.size())return false;for(unsigned long long i=0;i<a.size();++i)if(!(a[i]==b[i]))return false;return true; }
template<class T> bool operator!=(const deque<T>& a,const deque<T>& b) { return !(a==b); }
template<class T> bool operator<(const deque<T>& a,const deque<T>& b) { unsigned long long n=a.size()<b.size()?a.size():b.size();for(unsigned long long i=0;i<n;++i){if(a[i]<b[i])return true;if(b[i]<a[i])return false;}return a.size()<b.size(); }
template<class T> bool operator>(const deque<T>& a,const deque<T>& b) { return b<a; }
template<class T> bool operator<=(const deque<T>& a,const deque<T>& b) { return !(b<a); }
template<class T> bool operator>=(const deque<T>& a,const deque<T>& b) { return !(a<b); }
}
#endif
