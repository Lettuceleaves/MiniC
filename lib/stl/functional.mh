#ifndef CRAKEN_STL_FUNCTIONAL_MH
#define CRAKEN_STL_FUNCTIONAL_MH
#include "utility.mh"
#include <string.h>
namespace std {
template<class T> struct hash {unsigned long long operator()(const T& v) const noexcept{return (unsigned long long)v;}};
template<class T> struct hash<T*> {unsigned long long operator()(T* v) const noexcept{return (unsigned long long)v;}};
template<> struct hash<float> {unsigned long long operator()(float v) const noexcept{if(v==0)return 0;unsigned int bits=0;::memcpy(&bits,&v,sizeof(v));return bits;}};
template<> struct hash<double> {unsigned long long operator()(double v) const noexcept{if(v==0)return 0;unsigned long long bits=0;::memcpy(&bits,&v,sizeof(v));return bits;}};
template<> struct hash<long double> {unsigned long long operator()(long double v) const noexcept{return hash<double>()((double)v);}};

template<class T = void> struct less {
    typedef T first_argument_type;
    typedef T second_argument_type;
    typedef bool result_type;
    constexpr bool operator()(const T& a,const T& b) const { return a<b; }
};
template<> struct less<void> {
    typedef void is_transparent;
    template<class T,class U> constexpr auto operator()(T&& a,U&& b) const
        -> decltype(std::forward<T>(a)<std::forward<U>(b)) { return std::forward<T>(a)<std::forward<U>(b); }
};
template<class T = void> struct greater {
    typedef T first_argument_type;
    typedef T second_argument_type;
    typedef bool result_type;
    constexpr bool operator()(const T& a,const T& b) const { return a>b; }
};
template<> struct greater<void> {
    typedef void is_transparent;
    template<class T,class U> constexpr auto operator()(T&& a,U&& b) const
        -> decltype(std::forward<T>(a)>std::forward<U>(b)) { return std::forward<T>(a)>std::forward<U>(b); }
};
template<class T = void> struct equal_to {
    typedef T first_argument_type;
    typedef T second_argument_type;
    typedef bool result_type;
    constexpr bool operator()(const T& a,const T& b) const { return a==b; }
};
template<> struct equal_to<void> {
    typedef void is_transparent;
    template<class T,class U> constexpr auto operator()(T&& a,U&& b) const
        -> decltype(std::forward<T>(a)==std::forward<U>(b)) { return std::forward<T>(a)==std::forward<U>(b); }
};
template<class T = void> struct not_equal_to {
    typedef T first_argument_type;
    typedef T second_argument_type;
    typedef bool result_type;
    constexpr bool operator()(const T& a,const T& b) const { return a!=b; }
};
template<> struct not_equal_to<void> {
    typedef void is_transparent;
    template<class T,class U> constexpr auto operator()(T&& a,U&& b) const
        -> decltype(std::forward<T>(a)!=std::forward<U>(b)) { return std::forward<T>(a)!=std::forward<U>(b); }
};
template<class T = void> struct less_equal {
    typedef T first_argument_type;
    typedef T second_argument_type;
    typedef bool result_type;
    constexpr bool operator()(const T& a,const T& b) const { return a<=b; }
};
template<> struct less_equal<void> {
    typedef void is_transparent;
    template<class T,class U> constexpr auto operator()(T&& a,U&& b) const
        -> decltype(std::forward<T>(a)<=std::forward<U>(b)) { return std::forward<T>(a)<=std::forward<U>(b); }
};
template<class T = void> struct greater_equal {
    typedef T first_argument_type;
    typedef T second_argument_type;
    typedef bool result_type;
    constexpr bool operator()(const T& a,const T& b) const { return a>=b; }
};
template<> struct greater_equal<void> {
    typedef void is_transparent;
    template<class T,class U> constexpr auto operator()(T&& a,U&& b) const
        -> decltype(std::forward<T>(a)>=std::forward<U>(b)) { return std::forward<T>(a)>=std::forward<U>(b); }
};
}
#endif
