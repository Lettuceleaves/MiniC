template<class T> constexpr typename remove_reference<T>::type&& move(T&& value) noexcept {
    return (typename remove_reference<T>::type&&)value;
}
template<class T> constexpr T&& forward(typename remove_reference<T>::type& value) noexcept { return (T&&)value; }
template<class T> constexpr typename enable_if<!is_lvalue_reference<T>::value,T&&>::type forward(typename remove_reference<T>::type&& value) noexcept { return (T&&)value; }
template<class T> constexpr T* addressof(T& value) noexcept { return __builtin_addressof(value); }
template<class T> const T* addressof(const T&&) = delete;
template<class T> typename enable_if<is_move_constructible<T>::value && is_move_assignable<T>::value>::type swap(T& a, T& b) noexcept(is_nothrow_move_constructible<T>::value && is_nothrow_move_assignable<T>::value) { T saved=std::move(a); a=std::move(b); b=std::move(saved); }
template<class T, unsigned long long N> typename enable_if<is_swappable<T>::value>::type swap(T (&a)[N], T (&b)[N]) noexcept(is_nothrow_swappable<T>::value) {
    for (unsigned long long i=0;i<N;++i) { using std::swap; swap(a[i],b[i]); }
}
template<class T> constexpr typename conditional<!is_nothrow_move_constructible<T>::value && is_copy_constructible<T>::value,const T&,T&&>::type
move_if_noexcept(T& value) noexcept { return std::move(value); }
struct __craken_pair_key_tag {};
struct __craken_disabled_pair_assignment { __craken_disabled_pair_assignment() = delete; };
template<class T> void __craken_pair_implicit_default(T);
template<class T,class Probe=decltype(__craken_pair_implicit_default<T>({}))> true_type __craken_pair_default_probe(int);
template<class T> false_type __craken_pair_default_probe(...);
template<class T> struct __craken_pair_default_implicit {
    static const bool value = decltype(__craken_pair_default_probe<T>(0))::value;
};
template<class T, class U> struct pair {
