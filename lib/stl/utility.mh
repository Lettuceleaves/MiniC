    pair(pair&&) = default;
    template<class A=T,class B=U,typename enable_if<is_constructible<A,const A&>::value && is_constructible<B,const B&>::value
        && is_convertible<const A&,A>::value && is_convertible<const B&,B>::value,int>::type Enabled=0>
    constexpr pair(const T& a,const U& b):first(a),second(b) {}
    template<class A=T,class B=U,typename enable_if<is_constructible<A,const A&>::value && is_constructible<B,const B&>::value
        && !(is_convertible<const A&,A>::value && is_convertible<const B&,B>::value),long>::type Enabled=0>
    explicit constexpr pair(const T& a,const U& b):first(a),second(b) {}
    template<class A,class B,typename enable_if<is_constructible<T,A&&>::value && is_constructible<U,B&&>::value
        && is_convertible<A&&,T>::value && is_convertible<B&&,U>::value,int>::type Enabled=0>
    constexpr pair(A&& a,B&& b):first(std::forward<A>(a)),second(std::forward<B>(b)) {}
    template<class A,class B,typename enable_if<is_constructible<T,A&&>::value && is_constructible<U,B&&>::value
        && !(is_convertible<A&&,T>::value && is_convertible<B&&,U>::value),long>::type Enabled=0>
    explicit constexpr pair(A&& a,B&& b):first(std::forward<A>(a)),second(std::forward<B>(b)) {}
    template<class A,class B,typename enable_if<is_constructible<T,const A&>::value && is_constructible<U,const B&>::value
        && is_convertible<const A&,T>::value && is_convertible<const B&,U>::value,int>::type Enabled=0>
    constexpr pair(const pair<A,B>& other):first(other.first),second(other.second) {}
