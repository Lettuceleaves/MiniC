template<class T,class U> constexpr bool operator==(const pair<T,U>& a,const pair<T,U>& b) { return a.first==b.first && a.second==b.second; }
template<class T,class U> constexpr bool operator!=(const pair<T,U>& a,const pair<T,U>& b) { return !(a==b); }
template<class T,class U> constexpr bool operator<(const pair<T,U>& a,const pair<T,U>& b) { return a.first<b.first || (!(b.first<a.first) && a.second<b.second); }
template<class T,class U> constexpr bool operator>(const pair<T,U>& a,const pair<T,U>& b) { return b<a; }
template<class T,class U> constexpr bool operator<=(const pair<T,U>& a,const pair<T,U>& b) { return !(b<a); }
template<class T,class U> constexpr bool operator>=(const pair<T,U>& a,const pair<T,U>& b) { return !(a<b); }
template<class T,class U,class FirstSwap=decltype(swap(std::declval<T&>(),std::declval<T&>())),
    class SecondSwap=decltype(swap(std::declval<U&>(),std::declval<U&>()))>
void swap(pair<T,U>& a,pair<T,U>& b) noexcept(noexcept(a.swap(b))) { a.swap(b); }
template<class T,class U> constexpr pair<typename decay<T>::type,typename decay<U>::type> make_pair(T&& a,U&& b) {
    return pair<typename decay<T>::type,typename decay<U>::type>(std::forward<T>(a),std::forward<U>(b));
}
