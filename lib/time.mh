/* Craken compatibility declarations for <time.h>. */
#ifndef CRAKEN_TIME_MH
#define CRAKEN_TIME_MH

/* Windows x64 uses 32-bit clock_t and 64-bit time_t. */
typedef long clock_t;
typedef long long time_t;

struct tm {
    int tm_sec;
    int tm_min;
    int tm_hour;
    int tm_mday;
    int tm_mon;
    int tm_year;
    int tm_wday;
    int tm_yday;
    int tm_isdst;
};

#define CLOCKS_PER_SEC 1000L

extern clock_t clock(void);
extern double difftime(time_t later, time_t earlier);
extern time_t time(time_t *destination);
extern time_t mktime(struct tm *timeValue);
extern struct tm *gmtime(time_t *timeValue);
extern struct tm *localtime(time_t *timeValue);
extern unsigned long long strftime(
    char *buffer,
    unsigned long long size,
    const char *format,
    struct tm *timeValue
);

#endif
