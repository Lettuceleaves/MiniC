#ifndef MINIC_LIMITS_MH
#define MINIC_LIMITS_MH

/* MiniC targets the Windows x64 LLP64 data model. */
#define BOOL_WIDTH 1
#define BOOL_MAX 1
#define CHAR_BIT 8
#define CHAR_WIDTH 8
#define SCHAR_WIDTH 8
#define UCHAR_WIDTH 8
#define SHRT_WIDTH 16
#define USHRT_WIDTH 16
#define INT_WIDTH 32
#define UINT_WIDTH 32
#define LONG_WIDTH 32
#define ULONG_WIDTH 32
#define LLONG_WIDTH 64
#define ULLONG_WIDTH 64

/* MiniC currently exposes only its single-byte execution character model. */
#define MB_LEN_MAX 1

#define SCHAR_MIN (-127 - 1)
#define SCHAR_MAX 127
#define UCHAR_MAX 255U
#define CHAR_MIN SCHAR_MIN
#define CHAR_MAX SCHAR_MAX
#define SHRT_MIN (-32767 - 1)
#define SHRT_MAX 32767
#define USHRT_MAX 65535U
#define INT_MIN (-2147483647 - 1)
#define INT_MAX 2147483647
#define UINT_MAX 4294967295U
#define LONG_MIN (-2147483647L - 1L)
#define LONG_MAX 2147483647L
#define ULONG_MAX 4294967295UL
#define LLONG_MIN (-9223372036854775807LL - 1LL)
#define LLONG_MAX 9223372036854775807LL
#define ULLONG_MAX 18446744073709551615ULL

/*
 * Intentionally absent: BITINT_MAXWIDTH and __STDC_VERSION_LIMITS_H__.
 * MiniC does not implement C23 _BitInt and therefore does not claim the
 * complete C23 <limits.h> contract.
 */
#endif
