{
  "name": "minic-uiweb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:mirror": "node tools/generate-uiweb.mjs",
    "verify:mirror": "node tools/verify-uiweb-mirror.mjs",
    "verify:mirror-signatures": "node tools/verify-uiweb-mirror-signatures.mjs",
    "verify:adapter-completeness": "node tools/verify-uiapi-adapter-completeness.mjs",
    "verify:placeholders": "node tools/verify-no-mirror-placeholders.mjs",
    "verify:no-runtime-downgrade": "node tools/verify-no-uiweb-runtime-downgrade.mjs",
    "verify:editor-scroll": "node tools/verify-editor-scroll.mjs",
    "verify:parity": "npm run verify:mirror && npm run verify:placeholders && npm run verify:editor-scroll && npm run typecheck && npm run build",
    "verify:strict-parity": "npm run verify:mirror && npm run verify:mirror-signatures && npm run verify:placeholders && npm run verify:no-runtime-downgrade && npm run verify:adapter-completeness && npm run verify:editor-scroll && npm run typecheck && npm run build",
    "verify:strict-final": "npm run verify:strict-parity",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@tanstack/react-query": "^5.95.0",
    "@xyflow/react": "^12.9.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.8"
    }
  }
}
